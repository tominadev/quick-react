export const renderWechatQrPage = (apiPath: string, signPath: string, popup: boolean) => `<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>微信扫码登录</title>
<style>html,body{margin:0;min-height:100%;font-family:system-ui,-apple-system,sans-serif}body{min-height:100vh;display:grid;place-items:center;background:#405a75;color:#d8e5f0}.card{width:min(420px,calc(100% - 48px));padding:30px 26px;text-align:center;border:1px solid #607992;border-radius:16px;background:#536d88;box-shadow:0 16px 42px #13233455}h2{margin:0 0 18px;color:#f2f7fb;font-size:20px}#qr{display:inline-block;margin:10px auto 20px;padding:10px;background:#fff;border-radius:8px}.message{margin:12px 0;color:#d8e5f0}.error{color:#ffd6d6}.hidden{display:none}input{box-sizing:border-box;width:100%;padding:10px;border:1px solid #9eb2c5;border-radius:6px;background:#eef4f8;color:#1d2a38;font-size:15px}button{margin:8px 4px;padding:9px 16px;border:0;border-radius:6px;background:#dcebf7;color:#29415a;cursor:pointer;font-size:14px}button.primary{background:#f2f7fb}button:disabled{opacity:.6;cursor:not-allowed}.row{display:flex;gap:8px}.row input{flex:1}.row button{white-space:nowrap}</style></head>
<body><main class="card"><h2>微信扫码登录</h2><div id="qr"></div><p id="message" class="message">正在获取二维码…</p><section id="email" class="hidden"><p>微信身份已确认，请输入用于 Accounts 的邮箱。</p><div class="row"><input id="emailInput" type="email" placeholder="请输入邮箱"><button id="send" class="primary">发送验证码</button></div></section><section id="code" class="hidden"><p id="codeMessage"></p><div class="row"><input id="codeInput" inputmode="numeric" maxlength="6" placeholder="请输入 6 位验证码"><button id="verify" class="primary">验证邮箱</button></div><button id="change">更换邮箱</button></section><div><button id="refresh" class="hidden">刷新二维码</button><button id="fallback" class="hidden">更换邮箱或使用 Google 登录</button></div></main>
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script><script>
const api=${JSON.stringify(apiPath)}, sign=${JSON.stringify(signPath)}, popup=${popup ? 'true' : 'false'};let pollTimer,bindUrl='';
const $=id=>document.getElementById(id), show=(id,on)=>$(id).classList.toggle('hidden',!on), message=(text,error=false)=>{ $('message').textContent=text; $('message').className='message'+(error?' error':''); };
const stop=()=>{if(pollTimer)clearInterval(pollTimer);pollTimer=undefined};
async function load(){stop();show('refresh',false);show('fallback',false);show('email',false);show('code',false);$('qr').innerHTML='';message('正在获取二维码…');try{const r=await fetch(api+'?format=json'+(popup?'&popup=1':''),{credentials:'include'}),d=await r.json();if(!r.ok)throw new Error(d.feedback?.message||d.message||'获取二维码失败');if(d.fallbackUrl){$('fallback').onclick=()=>location.assign(d.fallbackUrl);show('fallback',true)}new QRCode($('qr'),d.authorizationUrl);message('请使用微信扫描二维码');pollTimer=setInterval(async()=>{try{const p=await (await fetch(d.pollUrl,{credentials:'include'})).json();if(p.status==='authenticated'){stop();location.assign(p.redirectTo||'/')}else if(p.status==='needs_email'){stop();bindUrl=p.bindUrl;show('qr',false);show('email',true);message('微信身份已确认，请验证邮箱')}else if(p.status==='expired'){stop();show('refresh',true);message('二维码已失效，请刷新后重新扫码',true)}else if(p.status==='error'){stop();show('refresh',true);message(p.error||'登录失败，请刷新二维码后重试',true)}}catch{stop();show('refresh',true);message('轮询二维码状态失败，请刷新二维码后重试',true)}},2000)}catch(e){show('refresh',true);message(e.message||'获取二维码失败',true)}}
$('refresh').onclick=load;$('fallback').onclick=()=>location.assign(sign);$('send').onclick=async()=>{const email=$('emailInput').value.trim();if(!email)return message('请输入邮箱',true);if(!confirm('验证码将发送到：'+email+'\\n请确认邮箱地址正确。'))return;const r=await fetch(bindUrl,{method:'POST',headers:{'content-type':'application/json'},credentials:'include',body:JSON.stringify({step:'email',email})}),d=await r.json();if(!r.ok){message(d.feedback?.message||'验证码发送失败',true);return}show('email',false);show('code',true);$('codeMessage').textContent='请到 '+email+' 查收邮件，验证码已发送到该地址。'};$('change').onclick=()=>{show('code',false);show('email',true);$('emailInput').focus()};$('verify').onclick=async()=>{const code=$('codeInput').value.trim();if(!/^\\d{6}$/.test(code))return;$('verify').disabled=true;const r=await fetch(bindUrl,{method:'POST',headers:{'content-type':'application/json'},credentials:'include',body:JSON.stringify({step:'verify',code})}),d=await r.json();if(!r.ok){message(d.feedback?.message||'邮箱验证失败',true);$('verify').disabled=false;return}location.assign(d.redirectTo||'/')};load();
</script></body></html>`;
