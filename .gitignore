~*

# Node.js dependencies
node_modules/
package-lock.json

# TypeScript build output
dist/
public/bundle.js
public/bundle.js.map
public/bundle-antd-mobile.js
public/bundle-antd-mobile.js.map
public/bundle-antd-mobile.css
public/bundle-antd-mobile.css.map
public/passport.js
public/passport.js.map
/server/worker-api-registry.mts
/server/.generated/

# Runtime databases and backups
/database/

# 本机配置：SNOWFLAKE_WORKER_ID 由启动时按服务器标识推出来并写在这里，
# 每台机器一份，不进版本库——进了就会两台机器共用同一个 worker id。
/.env

# 自签证书：每台机器自己生成，不进版本库
/certs/

# tools/ 里的工具：配置、生成的源码、编译产物和运行状态都留在本机。
# 带凭证编出来的二进制和 Embedded.swift 含明文密钥，尤其不能进版本库。
tools/**/.env
tools/**/Sources/Core/Embedded.swift
tools/**/*.app/
tools/**/.shortcut-gen-state.json
# 编出来的二进制写全路径，不用 tools/**/shortcut-generator：gitignore 的模式分不清文件和目录，
# 那样写会连同名的工具目录一起忽略掉。
tools/sms/shortcut-generator/shortcut-generator

# 文档站点由 scripts/generate-docs-site.cjs 在构建时生成，源头是 docs/。
public/docs/
