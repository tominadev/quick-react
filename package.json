{
	"name": "quick-react",
	"version": "1.0.0",
	"description": "quick react",
	"type": "module",
	"main": "esbuild.cjs",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"build": "node esbuild.cjs",
		"build:worker": "SKIP_SERVER_LISTEN=1 node esbuild.cjs",
		"dev": "node esbuild.cjs --watch --start",
		"dev:restart": "node esbuild.cjs --watch --start --restart",
		"start": "node dist/server.mjs",
		"typecheck": "npm run schema:verify && node scripts/generate-worker-registry.cjs && tsc --noEmit",
		"smoke:multi-site": "node scripts/smoke-multi-site.mjs",
		"test:passport-identity": "node scripts/test-passport-identity.mjs",
		"test:passport-login": "node scripts/test-passport-login.mjs",
		"test:passport-migration": "node scripts/test-passport-migration.mjs",
		"test:accounts-oidc": "node scripts/test-accounts-oidc.mjs",
		"test:accounts-external": "node scripts/test-accounts-external.mjs",
		"test:accounts-center": "node scripts/test-accounts-center.mjs",
		"test:accounts-avatar": "node scripts/test-accounts-avatar.mjs",
		"test:accounts-login-disabled": "node scripts/test-accounts-login-disabled.mjs",
		"test:accounts-wechat-qr": "node scripts/test-accounts-wechat-qr.mjs",
		"test:accounts-split-database": "node scripts/test-accounts-split-database.mjs",
		"test:sql-builder": "node scripts/test-sql-builder.mjs",
		"test:database-migrations": "node scripts/test-database-migrations.mjs",
		"test:database-transfer": "node scripts/test-database-transfer.mjs",
		"test:site-database": "node scripts/test-site-database.mjs",
		"test:table-form": "node scripts/test-table-form.mjs",
		"test:navigation-menu": "node scripts/test-navigation-menu.mjs",
		"test:user-roles": "node scripts/test-user-roles.mjs",
		"test:home-page": "node scripts/test-home-page.mjs",
		"test:personal-center": "node scripts/test-personal-center.mjs",
		"test:wwwroot-override": "node scripts/test-wwwroot-override.mjs",
		"test:page-status": "node scripts/test-page-status.mjs",
		"test:page-status-browser": "node scripts/test-page-status-browser.mjs",
		"test:form-linkage-browser": "node scripts/test-form-linkage-browser.mjs",
		"test:sign-form-browser": "node scripts/test-sign-form-browser.mjs",
		"test:table-switch-browser": "node scripts/test-table-switch-browser.mjs",
		"test:menu-revisit-browser": "node scripts/test-menu-revisit-browser.mjs",
		"test:recycle-bin": "node scripts/test-recycle-bin.mjs",
		"test:maintenance-rescue": "node scripts/test-maintenance-rescue.mjs",
		"test:response-action": "node scripts/test-response-action.mjs",
		"test:shell-fallback": "node scripts/test-shell-fallback.mjs",
		"test:table-url-state": "node scripts/test-table-url-state.mjs",
		"test:form-changes": "node scripts/test-form-changes.mjs",
		"test:audit-scope": "node scripts/test-audit-scope.mjs",
		"test:column-order": "node scripts/test-column-order.mjs",
		"test:change-audit": "node scripts/test-change-audit.mjs",
		"import:legacy-passport": "node scripts/import-legacy-passport.mjs",
		"migrate:sqlite": "node scripts/migrate-sqlite.mjs",
		"prisma:migrations": "node scripts/generate-prisma-migrations.mjs",
		"schema:verify": "node scripts/verify-prisma-migrations.mjs",
		"schema:check": "node scripts/schema-repair.mjs --check",
		"schema:repair": "node scripts/schema-repair.mjs",
		"test": "node esbuild.cjs",
		"test:naming": "node scripts/test-naming-convention.mjs",
		"test:super-users": "node scripts/test-super-users.mjs",
		"test:agent-claim": "node scripts/test-agent-claim.mjs",
		"test:object-browser": "node scripts/test-object-browser.mjs",
		"test:sms-push": "node scripts/test-sms-push.mjs",
		"test:table-crud-protocol": "node scripts/test-table-crud-protocol.mjs",
		"test:web-clients": "node scripts/test-web-clients.mjs",
		"test:sms-ticket-bind": "node scripts/test-sms-ticket-bind.mjs",
		"test:sms-generator-pool": "node scripts/test-sms-generator-pool.mjs"
	},
	"keywords": [
		"react"
	],
	"license": "ISC",
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"antd": "^6.6.0",
		"antd-mobile": "^5.42.3",
		"esbuild": "^0.28.2",
		"jsdom": "^30.0.1",
		"prisma": "^6.19.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"hono": "^4.13.2",
		"mysql2": "^3.24.2",
		"pg": "^8.23.0"
	}
}
