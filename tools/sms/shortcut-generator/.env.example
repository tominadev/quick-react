# 这台生成机的连接配置。复制成 .env 再填，权限设成 600：
#   cp .env.example .env && chmod 600 .env
# .env 不进版本库。整份内容由 SMS 后台的「生成机器」管理页在创建或重置凭证时生成，
# 运维复制到对应的 Mac 即可（需求文档 §3）。

# 生成器接口地址，指向 shortcut-tokens.php
SMS_API_ENDPOINT=https://sms.example.com/api/platform/shortcut-tokens.php

# 平台预配凭证。**这一项将被 Ed25519 密钥对取代**，见 README 的「已知缺口」。
SMS_PROVISIONING_KEY=

# 可选：设了这两个之后无参运行就按此补货（配 launchd 定时，或用 --interval 常驻循环）
# TARGET_AVAILABLE=50
# INTERVAL=300
