datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model pve_regions {
  id           Int    @id @default(autoincrement())
  code         String @unique
  name         String
  display_name String
  status       String @default("enabled")
  sort_order   Int    @default(0)
  created_at   Int    @default(0)
  updated_at   Int    @default(0)
  created_duid  String?
  updated_duid  String?
}

model pve_nodes {
  id               Int    @id @default(autoincrement())
  region_id        Int
  name             String
  host             String
  port             Int    @default(8006)
  cluster_name     String @default("")
  api_user         String
  api_token_id     String
  api_token_secret String
  status           String @default("enabled")
  last_checked_at  Int?
  last_error       String @default("")
  created_at       Int    @default(0)
  updated_at       Int    @default(0)
  created_duid      String?
  updated_duid      String?
}

model pve_instance_flavors {
  id                   BigInt @id @default(autoincrement())
  created_at           BigInt
  updated_at           BigInt
  created_duid         BigInt?
  updated_duid         BigInt?
  instance_flavor_code String
  name                 String
  cpu_cores            Int
  memory_gb            Int
  status               String @default("enabled")
  sort_order           Int    @default(0)

  @@unique([cpu_cores, memory_gb])
}

model pve_vms {
  id                 Int    @id @default(autoincrement())
  kind               String @default("qemu")
  region_id          Int
  node_id            Int
  instance_flavor_id BigInt
  name               String @default("")
  status             String @default("allocating")
  pve_status         String @default("")
  pve_config         String @default("{}")
  error_message      String @default("")
  created_at         Int    @default(0)
  updated_at         Int    @default(0)
  deleted_at         Int?
  created_duid        String?
  updated_duid        String?
}

model pve_vm_tasks {
  id               Int    @id @default(autoincrement())
  vm_id            Int
  action           String
  idempotency_key  String @unique
  status           String @default("pending")
  request_payload  String @default("{}")
  response_payload String @default("{}")
  retry_count      Int    @default(0)
  error_message    String @default("")
  created_at       Int    @default(0)
  updated_at       Int    @default(0)
  created_duid      String?
  updated_duid      String?
}
