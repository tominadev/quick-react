datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseUserStatus {
  enabled
  disabled
}

enum BaseDeviceStatus {
  active
  revoked
}

model base_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  created_duid BigInt?
  updated_duid BigInt?
  username      String @unique
  password      String
  roles         String[] @default([])
  status        BaseUserStatus @default(enabled)
}

model base_sessions {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  created_duid BigInt?
  updated_duid BigInt?
  token_hash String @unique
  user_id    BigInt
  expires_at BigInt
}

model base_configs {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  created_duid BigInt?
  updated_duid BigInt?
  key        String @unique
  value      String
}

model base_bootstrap {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  created_duid BigInt?
  updated_duid BigInt?
  key          String @unique
  value        String
}

model base_oidc_login_requests {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  created_duid  BigInt?
  updated_duid  BigInt?
  request_id    String @unique
  issuer        String
  state         String @unique
  nonce         String
  code_verifier String
  return_path   String @default("/")
  expires_at    BigInt
}

model base_oidc_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  created_duid  BigInt?
  updated_duid  BigInt?
  issuer        String
  subject       String
  user_id       BigInt
  profile       String @default("{}")

  @@unique([issuer, subject])
}

model base_oidc_sessions {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  created_duid  BigInt?
  updated_duid  BigInt?
  issuer        String
  sid           String
  session_id    BigInt @unique

  @@unique([issuer, sid])
}

model base_devices {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  user_id      BigInt
  fingerprint  String @unique
  user_agent   String @default("")
  platform     String @default("")
  ip_address   String @default("")
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?
}

model base_device_users {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  device_id    BigInt
  user_id      BigInt
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([device_id, user_id])
}

model base_device_snapshots {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  device_id     BigInt
  fingerprint   String
  ip_address    String @default("")
  user_agent    String @default("")
  platform      String @default("")
  screen_width  Int    @default(0)
  screen_height Int    @default(0)
  captured_at   BigInt
}
