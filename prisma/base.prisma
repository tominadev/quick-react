datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseUserStatus {
  enabled
  disabled
}

enum BaseDeviceStatus {
  active
  revoked
}

enum BaseTenantStatus {
  enabled
  disabled
}

/// 业务站点内部的租户。与 global_sites 的代码站点无关，命名一律不使用 site。
model base_tenants {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_uid    BigInt?
  key          String
  @@unique([key, deleted_at])
  name         String
  status       BaseTenantStatus @default(enabled)
}

/// 主机名到租户的映射。控制面只负责主机名到站点，租户解析在站点库内完成。
model base_tenant_hosts {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_uid    BigInt?
  hostname     String
  @@unique([hostname, deleted_at])
  tenant_id    BigInt
  status       BaseTenantStatus @default(enabled)
}

model base_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  name          String
  // 用户名在租户内唯一：不同租户可以各有同名账号。
  @@unique([name, owner_tid, deleted_at])
  password      String
  roles         String[] @default([])
  status        BaseUserStatus @default(enabled)
}

model base_sessions {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  token_hash String
  @@unique([token_hash, deleted_at])
  user_id    BigInt
  expires_at BigInt
  device_id  BigInt
}

model base_configs {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  key        String
  // 配置按租户独立：同一个 key 每个租户各存一份，owner_tid 为 NULL 的行是平台默认值。
  @@unique([key, owner_tid, deleted_at])
  value      String
}

model base_bootstrap {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  key          String
  // 引导状态同样按租户独立：每个租户各自创建自己的初始管理员。
  @@unique([key, owner_tid, deleted_at])
  value        String
}

model base_oidc_login_requests {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  request_id    String
  @@unique([request_id, deleted_at])
  issuer        String
  state         String
  @@unique([state, deleted_at])
  nonce         String
  code_verifier String
  return_path   String @default("/")
  expires_at    BigInt
}

model base_oidc_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  issuer        String
  subject       String
  user_id       BigInt
  profile       String @default("{}")

  // 同一个 Accounts 身份在每个租户各有一个本地账号。
  @@unique([issuer, subject, owner_tid, deleted_at])
}

model base_oidc_sessions {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  issuer        String
  sid           String
  session_id    BigInt
  @@unique([session_id, deleted_at])

  @@unique([issuer, sid, deleted_at])
}

model base_devices {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  user_id      BigInt
  key          String
  fingerprint  Json   @default("{}")
  user_agent   String @default("")
  platform     String @default("")
  ip_address   String @default("")
  network_info Json   @default("{}")
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([key, deleted_at])
}

model base_device_users {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  device_id    BigInt
  user_id      BigInt
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([device_id, user_id, deleted_at])
}

model base_device_snapshots {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_uid     BigInt?
  device_id     BigInt
  fingerprint   Json    @default("{}")
  ip_address    String @default("")
  network_info  Json    @default("{}")
  user_agent    String @default("")
  platform      String @default("")
  screen_width  Int    @default(0)
  screen_height Int    @default(0)
  captured_at   BigInt
}
