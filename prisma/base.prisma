datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseUserStatus {
  enabled
  disabled
}

enum BaseDeviceStatus {
  active
  revoked
}

model base_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  name          String
  @@unique([name, deleted_at])
  password      String
  roles         String[] @default([])
  status        BaseUserStatus @default(enabled)
}

model base_sessions {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  token_hash String
  @@unique([token_hash, deleted_at])
  user_id    BigInt
  expires_at BigInt
  device_id  BigInt
}

model base_configs {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  key        String
  @@unique([key, deleted_at])
  value      String
}

model base_bootstrap {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  key          String
  @@unique([key, deleted_at])
  value        String
}

model base_oidc_login_requests {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  request_id    String
  @@unique([request_id, deleted_at])
  issuer        String
  state         String
  @@unique([state, deleted_at])
  nonce         String
  code_verifier String
  return_path   String @default("/")
  expires_at    BigInt
}

model base_oidc_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  issuer        String
  subject       String
  user_id       BigInt
  profile       String @default("{}")

  @@unique([issuer, subject, deleted_at])
}

model base_oidc_sessions {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  issuer        String
  sid           String
  session_id    BigInt
  @@unique([session_id, deleted_at])

  @@unique([issuer, sid, deleted_at])
}

model base_devices {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  user_id      BigInt
  key          String
  fingerprint  Json   @default("{}")
  user_agent   String @default("")
  platform     String @default("")
  ip_address   String @default("")
  network_info Json   @default("{}")
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([key, deleted_at])
}

model base_device_users {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  device_id    BigInt
  user_id      BigInt
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([device_id, user_id, deleted_at])
}

model base_device_snapshots {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  device_id     BigInt
  fingerprint   Json    @default("{}")
  ip_address    String @default("")
  network_info  Json    @default("{}")
  user_agent    String @default("")
  platform      String @default("")
  screen_width  Int    @default(0)
  screen_height Int    @default(0)
  captured_at   BigInt
}
