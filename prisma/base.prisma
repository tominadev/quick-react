datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model base_users {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  created_duid BigInt?
  updated_duid BigInt?
  username      String @unique
  password      String
  roles         String @default("[]")
  status        String @default("enabled")
}

model base_sessions {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  created_duid BigInt?
  updated_duid BigInt?
  token_hash String @unique
  user_id    BigInt
  expires_at BigInt
}

model base_configs {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  created_duid BigInt?
  updated_duid BigInt?
  key        String @unique
  value      String
}

model base_bootstrap {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  created_duid BigInt?
  updated_duid BigInt?
  key          String @unique
  value        String
}

model base_devices {
  id           String @id
  created_at   BigInt
  updated_at   BigInt
  user_id      BigInt
  fingerprint  String @unique
  user_agent   String @default("")
  platform     String @default("")
  ip_address   String @default("")
  status       String @default("active")
  last_seen_at BigInt
  revoked_at   BigInt?
}

model base_device_users {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  device_id    String
  user_id      BigInt
  status       String @default("active")
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([device_id, user_id])
}

model base_device_snapshots {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  device_id     String
  fingerprint   String
  ip_address    String @default("")
  user_agent    String @default("")
  platform      String @default("")
  screen_width  Int    @default(0)
  screen_height Int    @default(0)
  captured_at   BigInt
}
