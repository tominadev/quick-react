datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model base_system_users {
  id            Int    @id @default(autoincrement())
  created_at    Int
  updated_at    Int
  created_uid   BigInt @default(0)
  updated_uid   BigInt @default(0)
  username      String @unique
  password      String
  roles         String @default("[]")
  status        String @default("enabled")
}

model base_system_sessions {
  id         String @id
  created_at Int
  updated_at Int @default(0)
  created_uid BigInt @default(0)
  updated_uid BigInt @default(0)
  user_id    Int
  expires_at Int
}

model base_system_configs {
  key        String @id
  created_at Int @default(0)
  updated_at Int
  created_uid BigInt @default(0)
  updated_uid BigInt @default(0)
  value      String
}

model base_system_bootstrap {
  key   String @id
  created_at Int @default(0)
  updated_at Int @default(0)
  created_uid BigInt @default(0)
  updated_uid BigInt @default(0)
  value String
}
