datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalEnabledStatus {
  enabled
  disabled
}

enum GlobalMigrationStatus {
  creating
  migrating
  ready
  failed
}

enum GlobalPublicationStatus {
  reviewing
  ready
  rejected
  failed
}

model global_sites {
  id               BigInt @id @default(autoincrement())
  key              String @db.VarChar(36)
  @@unique([key])
  created_at       BigInt @default(0)
  updated_at       BigInt @default(0)
  deleted_at       BigInt @default(0)
  queued_at        BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  title            String
  base_site_key    String?
  dsn              String  @default("")
  dsn_password     String?
  database_binding String  @default("")
  status           GlobalEnabledStatus  @default(enabled)
  migration_status GlobalMigrationStatus @default(ready)
  is_default       Boolean     @default(false)
  is_system        Boolean     @default(false)
  passport_sso_enabled Boolean  @default(false)
  @@index([base_site_key])
}

model global_site_hosts {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt @default(0)
  deleted_at   BigInt @default(0)
  queued_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  hostname     String
  @@unique([hostname])
  site_key     String
  /// 这个域名用哪一套前端（`shared/web-clients.mts` 里的 key）。**空串表示用默认那一套。**
  ///
  /// 配在**域名**上而不是站点上：`m.example.com` 与 `www.example.com` 往往指向同一个站点、
  /// 同一批数据，只是 UI 不同。认不出的 key 回落到默认那一套而不是报错——这一列一旦拿不到
  /// 结果，整个域名就打不开，回落至少让人还能进后台把它改回来。
  client_key   String @default("")
  status       GlobalEnabledStatus @default(enabled)
  @@unique([key])
  @@index([site_key])
}

model global_cloud_credentials {
  id                BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at        BigInt
  updated_at        BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid      BigInt?
  updated_duid      BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  title             String
  @@unique([title])
  provider          String
  account_id        String @default("")
  access_key_id     String @default("")
  access_key_secret String @default("")
  status            GlobalEnabledStatus @default(enabled)
  @@unique([key])
  @@index([account_id])
  @@index([access_key_id])
}

model global_cloud_object_storage_buckets {
  id                  BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at          BigInt
  updated_at          BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid        BigInt?
  updated_duid        BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  cloud_credential_id BigInt
  endpoint            String
  region              String @default("")
  bucket              String
  path_style          Boolean    @default(false)
  public_base_url     String @default("")
  extra_config        String @default("{}")
  status              GlobalEnabledStatus @default(enabled)

  @@unique([cloud_credential_id, endpoint, bucket])
  @@unique([key])
}

model global_cloud_object_storage_bindings {
  id         BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  site_key   String
  bucket_id  BigInt
  /// 这个绑定负责哪几种用途，JSON 数组，例如 ["uploads","avatars"]。
  ///
  /// **用途是绑定的一个字段，不是子表。** 它在界面上就是一个多选框，拆成子表的话勾四个
  /// 用途会变成四条独立的审批申请、要批四次；而且用途没变时绑定行本身没有变化，
  /// 「待审批」那个标记挂不上去，提交完在列表上什么也看不出来。
  ///
  /// 同一站点的同一用途只允许绑一个 Bucket，由接口层校验。这条规则原先也不是数据库约束
  /// ——它靠代码里两条 UPDATE 维持——所以收回字段没有损失掉任何既有的约束。
  purposes   String @default("[]")
  key_prefix String @default("")
  status     GlobalEnabledStatus @default(enabled)

  @@unique([id, site_key])
  @@unique([site_key, bucket_id, key_prefix])
  @@unique([key])
}

model global_telegram_bots {
  id               BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at       BigInt
  updated_at       BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  title            String
  @@unique([title])
  token            String
  @@unique([token])
  username         String
  @@unique([username])
  secret_token     String
  webhook_hostname String
  status           GlobalEnabledStatus @default(enabled)

  @@index([webhook_hostname])
  @@unique([key])
}

model global_cloud_email_channels {
  id                  BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at          BigInt
  updated_at          BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid        BigInt?
  updated_duid        BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  cloud_credential_id BigInt
  region              String
  account_name        String
  from_alias          String
  /// 是否启用回信地址。存的是开关，不是地址——地址取自 account_name。
  reply_to_enabled    Boolean    @default(false)
  status              GlobalEnabledStatus @default(enabled)

  @@unique([cloud_credential_id, region, account_name])
  @@unique([key])
}

model global_cloud_email_templates {
  id            BigInt @id @default(autoincrement())
  key           String @db.VarChar(36)
  @@unique([key])
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  type          String @default("email_verification")
  title         String
  subject       String
  body_text     String
  body_html     String
  status        GlobalEnabledStatus @default(enabled)
}

model global_cloud_email_bindings {
  id         BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  site_key   String
  channel_id BigInt
  template_id BigInt
  purpose    String
  is_default Boolean    @default(false)
  status     GlobalEnabledStatus @default(enabled)

  @@unique([site_key, channel_id, template_id, purpose])
  @@unique([key])
}

model global_cloud_email_template_publications {
  id                   BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at           BigInt
  updated_at           BigInt
  deleted_at BigInt @default(0)
  queued_at  BigInt @default(0)
  created_duid         BigInt?
  updated_duid         BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  template_id          BigInt
  cloud_credential_id  BigInt
  region               String
  provider_template_id String
  content_hash         String @default("")
  status               GlobalPublicationStatus

  @@unique([template_id, cloud_credential_id, region])
  @@unique([key])
  @@index([provider_template_id])
}
/// 雪花发号器的号段状态。全站共享一份：每张业务表的 key 都由它发。
///
/// 每个 worker 一行，`last_at` 是**已经预留到哪个逻辑毫秒**。预留走原子推进
/// （UPDATE 的 WHERE 带旧值），因此两个进程即使配了同一个 worker id，拿到的也是彼此
/// 不相交的两段；进程重启后从这里接着往下走，不会把发过的号再发一遍。
///
/// 这张表自己没有 key 列——发 key 要先读它，加上去就成了死循环。
model global_snowflake_states {
  id             BigInt @id @default(autoincrement())
  created_at     BigInt
  updated_at     BigInt
  deleted_at     BigInt @default(0)
  queued_at      BigInt @default(0)
  created_duid   BigInt?
  updated_duid   BigInt?
  owner_tid      BigInt @default(1)
  owner_bid      BigInt @default(1)
  owner_uid      BigInt?
  worker_id      Int
  @@unique([worker_id])
  last_at BigInt
}
