datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseUserStatus {
  enabled
  disabled
}

enum BaseDeviceStatus {
  active
  revoked
}

enum BaseTenantStatus {
  enabled
  disabled
}

enum BaseApprovalAction {
  /// 新建一行。待审批期间行**已经写进库**，但 `pended_at` 非零让它对所有正常查询不可见——
  /// 批准就是把 pended_at 归零，驳回就是把那一行物理删掉（它从未生效过，历史留在这条记录上）。
  /// 这样待建行的值不必存进审批表：值就在行上，凭证也就不会在这张表里躺满保留期。
  insert
  update
  soft_delete
  restore
  /// 从回收站彻底删除。行没了，因此这一条不可回滚；它存在只是为了留下「谁删的」。
  purge
}

enum BaseApprovalEvent {
  approve
  reject
  withdraw
  requeue
  revert
  redo
}

/// 审批状态：这次修改有没有人放行、是谁放行的。
///
/// 「没人批过」和「批过了」是两回事：前台自助与路由显式声明的机器写入根本没进过队列，
/// 把它们记成「已批准」是在伪造一次不存在的审批。
enum BaseApprovalReview {
  /// 无需审批：用户自助操作，或路由显式声明的机器写入（建号收尾、回收站恢复）。
  none
  /// 已提交，等审批：记录已写，数据还没动。
  pending
  approved
  /// 审批人否掉：数据从未被写入。
  rejected
  /// 申请人自己收回：数据从未被写入。与 rejected 落在同一侧，但不是同一件事，
  /// 因此分开记——追查时「是被否掉的还是自己撤的」是两个不同的结论。
  withdrawn
}

/// 数据状态：这次修改的值现在有没有落在表上。
///
/// 与审批状态**正交**。「撤销申请」与「回滚」因此各管一列：前者收回的是还没生效的申请
/// （审批状态变、数据没动过），后者把已经生效的变更改回去（数据状态变、是谁放行的不变）。
/// 合成一列的话，一条自助操作被回滚再恢复就会凭空变成「已批准」——记录被自己的状态机洗白。
enum BaseApprovalState {
  /// 从未写入：待审批、被驳回、被撤销的申请都停在这里。
  unwritten
  applied
  /// 生效之后被回滚：数据已经改回去了。
  reverted
}

/// 后台操作要审批，用户处置自己的数据不排队。两者留在同一张表里（分表会把「这一行被谁
/// 改过」的时间线劈成两半），靠这一列区分。
enum BaseApprovalScope {
  /// /panel/admin 下的后台操作。
  admin
  /// 个人中心、账户中心一类的用户自助操作，照常留痕但不排队。
  self
}

/// 业务站点内部的租户。与 global_sites 的代码站点无关，命名一律不使用 site。
model base_tenants {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  @@unique([key])
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  /// 租户标识（`default` 之类），人取的：因此落在 name 上，不占 key。
  /// key 是机器写的雪花号，跟 id 一样只用来指向这一行。
  name         String @db.VarChar(64)
  @@unique([name, deleted_at])
  title        String
  status       BaseTenantStatus @default(enabled)
}

/// 分站：租户下面的一层，绑定自己的域名，管理自己的用户与代理。
/// 分站 name 在租户内唯一：不同租户可以各有同名分站。
model base_branches {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  @@unique([key])
  /// 分站标识（`main` 之类），人取的。**在租户内唯一**：不同租户可以各有同名分站。
  name         String @db.VarChar(64)
  @@unique([owner_tid, name, deleted_at])
  title        String
  status       BaseTenantStatus @default(enabled)
}

/// 主机名到租户与分站的映射。控制面只负责主机名到站点，租户与分站的解析在站点库内完成。
/// 每个域名都必须同时绑定租户和分站：没有"不属于任何分站"的状态，租户自己的域名绑到它的主分站，
/// 这样用量与计费的聚合不需要处理 NULL 桶。
model base_hosts {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  hostname     String
  @@unique([hostname])
  tenant_id    BigInt
  branch_id    BigInt
  status       BaseTenantStatus @default(enabled)
  @@unique([key])
}

model base_users {
  id            BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  /// 发展这个账号的代理，指向同库 `base_users.id`；NULL 表示分站直属、无代理。
  ///
  /// **只存在这一张表。** 代理要看下级的业务数据走代查机制（每次显式指定一个账号并留痕），
  /// 不靠行级谓词——把它铺满全表的话，下级换个代理就要跨 64 张表回写，而 D1 没有事务，
  /// 改一半就是灾难（agent-tenants-and-management-views.md §4.2）。放在这里，换代理只改一行。
  ///
  /// 也不复用 owner_uid：那一列是行级可见性的判定依据（非管理员只看得到 owner_uid = 自己
  /// 的行），改成代理之后用户连自己的账号都查不到，「昵称不能与别人的用户名相同」那道
  /// 校验也会静悄悄失效。
  agent_uid     BigInt?
  @@index([agent_uid])
  name          String
  // 用户名在租户内唯一：不同租户可以各有同名账号。
  @@unique([owner_tid, name, deleted_at])
  roles         String[] @default([])
  status        BaseUserStatus @default(enabled)
  @@unique([key])
}

model base_sessions {
  id         BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  token_hash String
  @@unique([token_hash])
  user_id    BigInt
  expires_at BigInt
  device_id  BigInt
  @@unique([key])
}

model base_configs {
  id         BigInt @id @default(autoincrement())
  key        String @db.VarChar(36)
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  @@unique([key])
  /// 配置项名（`site.frontend` 之类），人取的。
  /// **配置按租户独立**：同一个 name 每个租户各存一份。
  name       String @db.VarChar(64)
  @@unique([owner_tid, name, deleted_at])
  value      String
}

model base_bootstrap {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  @@unique([key])
  /// 引导项名（`initial_admin`），人取的。
  /// **同样按租户独立**：每个租户各自创建自己的初始管理员。
  name         String @db.VarChar(64)
  @@unique([owner_tid, name, deleted_at])
  value        String
}

model base_oidc_login_requests {
  id            BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  request_id    String
  @@unique([request_id])
  issuer        String
  state         String
  @@unique([state])
  nonce         String
  code_verifier String
  return_path   String @default("/")
  expires_at    BigInt

  /// pending：还在等 Accounts 回调。
  /// choosing：回调已验证通过，但这个身份在本站还没有账号，正等用户选「新建」还是「绑定已有」。
  ///
  /// 之所以要把已验证的身份先存下来而不是当场建号：建号是不可撤销的副作用，而用户此刻
  /// 还没表态。先建一个占位号再按选择删掉，在没有事务的环境里意味着中间态会被别的请求看见。
  status        String @default("pending")
  /// choosing 阶段暂存已验证的 sub 与 claims，供选择页落定时使用；不再向 Accounts 二次换取。
  subject       String @default("")
  claims        String @default("{}")
  /// Accounts 下发的凭证 blob，单独一列而不是混进 claims：claims 最终会写进
  /// base_oidc_users.profile，那是「数据管理」里可见的普通列。这一列随请求行在落定时删掉，
  /// 列名进了 HIDDEN_VALUE_COLUMNS，接口不返回它的值。
  credential    String @default("")
  @@unique([key])
}

model base_oidc_users {
  id            BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  issuer        String
  subject       String
  user_id       BigInt
  profile       String @default("{}")

  // 同一个 Accounts 身份在每个租户各有一个本地账号。
  @@unique([owner_tid, issuer, subject])
  @@unique([key])
}

model base_oidc_sessions {
  id            BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  issuer        String
  sid           String
  session_id    BigInt
  @@unique([session_id])

  @@unique([issuer, sid])
  @@unique([key])
}

model base_devices {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  user_id      BigInt
  fingerprint  Json   @default("{}")
  user_agent   String @default("")
  platform     String @default("")
  ip_address   String @default("")
  network_info Json   @default("{}")
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([key])
}

model base_device_users {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  device_id    BigInt
  user_id      BigInt
  status       BaseDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([device_id, user_id])
  @@unique([key])
}

model base_device_snapshots {
  id            BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  pended_at  BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  owner_tid     BigInt @default(1)
  owner_bid     BigInt @default(1)
  owner_uid     BigInt?
  device_id     BigInt
  fingerprint   Json    @default("{}")
  ip_address    String @default("")
  network_info  Json    @default("{}")
  user_agent    String @default("")
  platform      String @default("")
  screen_width  Int    @default(0)
  screen_height Int    @default(0)
  captured_at   BigInt
  @@unique([key])
}

/// 变更留痕：受管表上每一次业务字段变更的前后值，同时用作操作日志与撤回依据。
/// 只覆盖 update（软删除与恢复同为 UPDATE），不覆盖 insert 与物理 delete。
/// 一条审批记录上发生过的每一次迁移，只追加不修改。
///
/// **不把它们压进 base_approvals 的列里。** 那样每加一种迁移就要加三列（谁、什么时候、
/// 为什么），而且只记得住最后一次——一条记录可以回滚→重新应用→再回滚，第一次回滚的
/// 时间和理由就没了。审计系统丢历史，比字段多更严重。
///
/// 业务列只有三个：谁和什么时候由公共层的 `created_duid` / `created_at` 顺带填上。
///
/// **不记「提交」。** base_approvals 那一行本身就是提交，`created_*` 已经写着谁在什么
/// 时候提的。因此前台自助改一次数据只有主表一行、事件表零行——它压根没走过审批，
/// 不必用一条事件去假装。
model base_approval_events {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  approval_id  BigInt
  kind         BaseApprovalEvent
  /// 这一次的理由。撤销没有理由——那是申请人把自己提的东西收回去，不需要向谁交代。
  reason       String @default("")
  @@index([approval_id, id])
  @@unique([key])
}

model base_approvals {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  /// 同一次人工操作可能写多张表多行，它们共享一个 operation_id 与同一条原因。
  operation_id String
  /// 操作原因：审计记录了「改了什么」，这一列记「为什么」，取证时后者更有价值。
  reason       String @default("")
  /// 这次操作来自后台还是用户自助。**与「要不要走审批」是同一条判定**（§11.2），
  /// 由 operationScope() 一处算出、两处使用。
  ///
  /// 写入时定下来，而不是事后拿 request_path 去 LIKE：判定规则以后会变（四眼原则要把
  /// 「谁能批」从按角色改成按操作），历史记录记的必须是**当时判定的事实**。
  scope        BaseApprovalScope @default(admin)
  /// 这次操作是从哪个域名、哪个接口发起的。
  ///
  /// 多站点共用一套代码，同一张表在不同域名下都可能被改；只记"改了什么"而不记"在哪改的"，
  /// 事后追查时分不清是哪个站点的管理员动的手。路径记接口路径而不是页面路径：页面路径
  /// 靠 referer 推断，客户端说什么就是什么，而接口路径是服务端自己看到的事实。
  request_hostname String @default("")
  request_path String @default("")
  table_name   String
  row_id       BigInt
  /// 被改动那一行的 key。
  ///
  /// 定位一律用它而不是 row_id：新建时**行还没写进去**，自增主键要插进去才知道，而 key
  /// 由 SQL 构造器在建语句时就生成好了——因此「先记录、后写行」这条顺序对新建也成立
  /// （§6.2：「记了但没做」可核对，「做了但没记」事后查不出来）。
  ///
  /// 另一条好处是不必依赖 lastInsertRowid：PostgreSQL 拿它要给每条 INSERT 追加
  /// RETURNING（本项目的 pg 适配器目前也没实现），而 key 三种方言一视同仁。
  /// row_id 仍然记着，用于显示与筛选；跨库搬迁后自增值会变，key 不会。
  row_key      String @db.VarChar(36) @default("")
  action       BaseApprovalAction
  /// 变更前后的值，**前后各一列**：`{列名: 值}`，只含实际发生变化的列。
  ///
  /// 不合成一列 `{列名: {before, after}}`：那样每个列名要写两遍、`"before"` 与 `"after"`
  /// 这两个词占掉大半篇幅，而新建记录里 before 全是 null——直接读库时满屏都是
  /// `{"nickname":{"before":null,"after":"admin1"},"qq":{"before":null,"after":"11"}}`，
  /// 想看「这次要新增什么」得先在噪音里把 after 挑出来。分开之后一眼就是一份值。
  ///
  /// 新建记录的 changes_before 是 `{}`——**空对象本身就说清了「这一行之前不存在」**，
  /// 比一串 null 干净。批准/驳回也不读它（那一支自己处理，见 applyInsertTransition）。
  changes_before Json @default("{}")
  changes_after  Json @default("{}")
  /// 审批走到哪一步。没进过队列的写入是 none，不是 approved。
  review_status BaseApprovalReview @default(none)
  /// 数据当前停在哪一边。applied ↔ reverted 可以来回翻：回滚不新开记录，
  /// 而是把这一条翻到另一面；审批状态不跟着变。
  data_status  BaseApprovalState @default(applied)
  @@index([owner_tid, created_at])
  @@index([owner_bid, created_at])
  @@index([owner_uid, created_at])
  @@index([table_name, row_id, created_at])
  @@index([operation_id])
  @@index([review_status, created_at])
  @@index([scope, created_at])
  @@unique([key])
}

/// 本站账号的登录凭证。
///
/// 与账号资料分表，和 passport_user_credentials 同构：
/// - **没有行就是没有本地密码**，不需要 '!oidc' 这类哨兵值；
/// - 列表查询不会捎带凭证；
/// - 改密码的审计落在这张表上，不和资料变更混在一起。
model base_user_credentials {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  user_id      BigInt
  /// 存的是 { hash, pattern }。
  password     Json

  /// 一个账号一份当前凭证；user_id 本身全局唯一，不必再按租户划分。
  @@unique([user_id])
  @@unique([key])
}

/// 本站账号的资料。
///
/// 与凭证一样从 base_users 拆出来：**没有行就是没设过资料**，昵称回落到用户名，
/// 不需要在建号时把用户名抄一份进昵称列（抄过去还会撞上别人挑走的昵称）。
model base_user_profiles {
  id           BigInt @id @default(autoincrement())
  key          String @db.VarChar(36)
  created_at   BigInt
  updated_at   BigInt
  deleted_at   BigInt @default(0)
  pended_at    BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  owner_tid    BigInt @default(1)
  owner_bid    BigInt @default(1)
  owner_uid    BigInt?
  user_id      BigInt
  /// 显示名，租户内唯一，但允许的字符比用户名多（中文都行）。
  ///
  /// 可空：NULL 表示没设昵称，显示时回落到用户名。不能用空串——唯一索引里空串互相相等，
  /// 第二个不设昵称的账号就建不出来了；NULL 互不相等，正好是这里要的语义。
  nickname     String?
  /// 联系方式，都不唯一也不校验格式：它们是给人看的，不是登录凭据。
  ///
  /// 三列都可空，与 nickname 一致：**没填过是 NULL，不是空串**。理由不是唯一索引（这三列
  /// 没有），而是让「从来没填」和「填过又清掉」在库里长得不一样——只有一张表把两者都
  /// 记成空串时，「这个人到底留没留过联系方式」就再也答不上来了。
  qq           String?
  wechat       String?
  /// 联系邮箱。本站没有邮箱验证流程，这里存的是人自己填的联系方式，不能当身份用。
  email        String?

  /// 一个账号一份资料；user_id 本身全局唯一，不必再按租户划分。
  @@unique([user_id])
  @@unique([owner_tid, nickname])
  @@unique([key])
}
