datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PassportAccountStatus {
  enabled
  disabled
}

enum PassportOtpStatus {
  pending
  expired
  used
}

enum PassportTelegramUpdateStatus {
  processing
  completed
  failed
}

enum PassportTelegramChoiceStatus {
  pending
  confirmed
  cancelled
  expired
}

enum PassportLoginChallengeStatus {
  pending
  approved
  denied
  consumed
  expired
}

enum PassportSsoStatus {
  pending
  consumed
  expired
}

enum PassportExternalPendingStatus {
  pending
  expired
  completed
}

enum PassportQrStatus {
  pending
  authorized
  consumed
}

enum PassportSigningKeyStatus {
  active
  retired
}

enum PassportDeviceStatus {
  active
  revoked
}

model passport_users {
  id          BigInt @id @default(autoincrement())
  created_at  BigInt
  updated_at  BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  user_id     BigInt
  @@unique([user_id, deleted_at])
  name        String
  @@unique([name, deleted_at])
  nickname    String
  status      PassportAccountStatus @default(enabled)
}

model passport_user_email_otps {
  id            BigInt @id @default(autoincrement())
  created_at    BigInt
  updated_at    BigInt
  deleted_at BigInt @default(0)
  created_duid  BigInt?
  updated_duid  BigInt?
  otp_id        String
  @@unique([otp_id, deleted_at])
  user_id       BigInt
  email         String
  code_hash     String
  attempt_count Int    @default(0)
  status        PassportOtpStatus @default(pending)
  expires_at    BigInt

  @@index([user_id, status, created_at])
}

model passport_user_credentials {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  user_id    BigInt
  password   String

  @@index([user_id, created_at, id])
}

model passport_sessions {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  token_hash String
  @@unique([token_hash, deleted_at])
  user_id    BigInt
  expires_at BigInt
  device_id  BigInt

  @@index([user_id])
  @@index([expires_at])
}

model passport_devices {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  key           String
  fingerprint  Json   @default("{}")
  user_agent   String @default("")
  platform     String @default("")
  ip_address   String @default("")
  network_info Json   @default("{}")
  status       PassportDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([key, deleted_at])
}

model passport_device_users {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  device_id    BigInt
  user_id      BigInt
  status       PassportDeviceStatus @default(active)
  last_seen_at BigInt
  revoked_at   BigInt?

  @@unique([device_id, user_id, deleted_at])
}

model passport_telegram_accounts {
  id               BigInt @id @default(autoincrement())
  created_at       BigInt
  updated_at       BigInt
  deleted_at BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  user_id          BigInt
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  nickname         String

  @@unique([bot_id, telegram_user_id, deleted_at])
}

model passport_oauth_accounts {
  id               BigInt @id @default(autoincrement())
  created_at       BigInt
  updated_at       BigInt
  deleted_at BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  user_id          BigInt
  provider         String
  provider_user_id String

  @@unique([provider, provider_user_id, deleted_at])
}

model passport_emails {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  email      String
  verified   Int    @default(0)

  @@unique([email, deleted_at])
}

model passport_user_emails {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  user_id    BigInt
  email_id   BigInt
  is_primary Int    @default(0)

  @@unique([user_id, email_id, deleted_at])
  @@unique([email_id, deleted_at])
}

model passport_email_otp {
  id               BigInt @id @default(autoincrement())
  created_at       BigInt
  updated_at       BigInt
  deleted_at BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  email            String
  code_hash        String
  attempt_count    Int    @default(0)
  status           PassportOtpStatus @default(pending)
  expires_at       BigInt

  @@index([bot_id, telegram_user_id, status, created_at])
}

model passport_snowflake_state {
  id             BigInt @id @default(autoincrement())
  created_at     BigInt
  updated_at     BigInt
  deleted_at BigInt @default(0)
  created_duid   BigInt?
  updated_duid   BigInt?
  worker_id      Int
  @@unique([worker_id, deleted_at])
  last_timestamp BigInt
}

model passport_telegram_menus {
  id                BigInt @id @default(autoincrement())
  created_at        BigInt
  updated_at        BigInt
  deleted_at BigInt @default(0)
  created_duid      BigInt?
  updated_duid      BigInt?
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  message_id       BigInt
  mode             String
  @@unique([bot_id, telegram_user_id, deleted_at])
}

model passport_telegram_updates {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  bot_id     BigInt
  update_id  BigInt
  status     PassportTelegramUpdateStatus
  @@unique([bot_id, update_id, deleted_at])
  @@index([status, updated_at])
}

model passport_telegram_identity_choices {
  id               BigInt @id @default(autoincrement())
  created_at       BigInt
  updated_at       BigInt
  deleted_at BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  target_user_id   BigInt
  email            String
  status           PassportTelegramChoiceStatus
  expires_at       BigInt

  @@index([bot_id, telegram_user_id, status, created_at])
}

model passport_login_challenges {
  id               BigInt @id @default(autoincrement())
  created_at       BigInt
  updated_at       BigInt
  deleted_at BigInt @default(0)
  created_duid     BigInt?
  updated_duid     BigInt?
  challenge_id     String
  @@unique([challenge_id, deleted_at])
  user_id          BigInt
  bot_id           BigInt
  telegram_user_id BigInt
  chat_id          BigInt
  expected_number  Int
  status           PassportLoginChallengeStatus
  expires_at       BigInt

  @@index([bot_id, telegram_user_id, status, created_at])
  @@index([status, expires_at])
}

model passport_sso_requests {
  id                BigInt @id @default(autoincrement())
  created_at        BigInt
  updated_at        BigInt
  deleted_at BigInt @default(0)
  created_duid      BigInt?
  updated_duid      BigInt?
  request_id        String
  @@unique([request_id, deleted_at])
  target_site_key   String
  target_hostname   String
  status            PassportSsoStatus
  expires_at        BigInt

  @@index([status, expires_at])
}

model passport_login_tickets {
  id                BigInt @id @default(autoincrement())
  created_at        BigInt
  updated_at        BigInt
  deleted_at BigInt @default(0)
  created_duid      BigInt?
  updated_duid      BigInt?
  token_hash        String
  @@unique([token_hash, deleted_at])
  user_id           BigInt
  target_site_key   String
  target_hostname   String
  status            PassportSsoStatus
  expires_at        BigInt

  @@index([status, expires_at])
}

model passport_site_sessions {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  session_id String
  @@unique([session_id, deleted_at])
  user_id    BigInt
  site_key   String
  hostname   String
  expires_at BigInt

  @@index([user_id])
  @@index([site_key, hostname, expires_at])
}

model passport_user_roles {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  user_id    BigInt
  role       String

  @@unique([user_id, role, deleted_at])
}

model passport_group_prompts {
  id         BigInt @id @default(autoincrement())
  created_at BigInt
  updated_at BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  chat_id    BigInt
  actor_id   BigInt
  state_json String @default("{}")
  expires_at BigInt

  @@index([chat_id, actor_id, updated_at])
}

model passport_external_email_otps {
  id                    BigInt @id @default(autoincrement())
  created_at            BigInt
  updated_at            BigInt
  deleted_at BigInt @default(0)
  created_duid          BigInt?
  updated_duid          BigInt?
  otp_id                String
  @@unique([otp_id, deleted_at])
  pending_identity_hash String
  email                 String
  code_hash             String
  attempt_count         Int    @default(0)
  status                PassportOtpStatus @default(pending)
  expires_at            BigInt

  @@index([pending_identity_hash, status, created_at])
}

model passport_external_identities {
  id          BigInt @id @default(autoincrement())
  created_at  BigInt
  updated_at  BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  user_id     BigInt
  provider    String
  subject     String
  profile     String @default("{}")

  @@unique([provider, subject, deleted_at])
  @@index([user_id])
}

model passport_external_login_states {
  id              BigInt @id @default(autoincrement())
  created_at      BigInt
  updated_at      BigInt
  deleted_at BigInt @default(0)
  created_duid    BigInt?
  updated_duid    BigInt?
  id_hash         String
  @@unique([id_hash, deleted_at])
  provider        String
  code_verifier   String
  nonce           String
  redirect_uri    String
  expires_at      BigInt
  consumed_at     BigInt?
  qr_status       PassportQrStatus @default(pending)
  qr_user_id      String?
  oidc_request_id String?

  @@index([expires_at, consumed_at])
}

model passport_external_pending_identities {
  id             BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  id_hash      String
  @@unique([id_hash, deleted_at])
  provider     String
  subject      String
  nickname     String
  profile      String
  status       PassportExternalPendingStatus @default(pending)
  expires_at   BigInt
}

model passport_external_pending_qr_states {
  id                     BigInt @id @default(autoincrement())
  created_at            BigInt
  updated_at            BigInt
  deleted_at BigInt @default(0)
  created_duid          BigInt?
  updated_duid          BigInt?
  pending_identity_hash String
  @@unique([pending_identity_hash, deleted_at])
  qr_state_hash         String
  @@unique([qr_state_hash, deleted_at])
}

model passport_external_providers {
  id                      BigInt @id @default(autoincrement())
  created_at              BigInt
  updated_at              BigInt
  deleted_at BigInt @default(0)
  created_duid            BigInt?
  updated_duid            BigInt?
  provider                String
  @@unique([provider, deleted_at])
  display_name            String
  client_id               String
  client_secret           String
  status                  PassportAccountStatus @default(enabled)
  wechat_mode             String @default("open_platform")
  wechat_redirect_domain  String @default("")
}

model passport_oidc_clients {
  id                     BigInt @id @default(autoincrement())
  created_at             BigInt
  updated_at             BigInt
  deleted_at BigInt @default(0)
  created_duid           BigInt?
  updated_duid           BigInt?
  client_id              String
  @@unique([client_id, deleted_at])
  name                   String
  secret_hash            String
  redirect_uris          String @default("[]")
  allowed_scopes         String @default("openid profile email")
  require_pkce           Int    @default(1)
  status                 PassportAccountStatus @default(enabled)
  backchannel_logout_uri String @default("")
  strict_redirect_uri    Int    @default(0)
}

model passport_oidc_authorization_requests {
  id                    BigInt @id @default(autoincrement())
  created_at            BigInt
  updated_at            BigInt
  deleted_at BigInt @default(0)
  created_duid          BigInt?
  updated_duid          BigInt?
  request_id            String
  @@unique([request_id, deleted_at])
  client_id             String
  redirect_uri          String
  scope                 String
  state                 String @default("")
  nonce                 String @default("")
  code_challenge        String @default("")
  code_challenge_method String @default("")
  expires_at            BigInt
}

model passport_oidc_authorization_codes {
  id                    BigInt @id @default(autoincrement())
  created_at            BigInt
  updated_at            BigInt
  deleted_at BigInt @default(0)
  created_duid          BigInt?
  updated_duid          BigInt?
  code_hash             String
  @@unique([code_hash, deleted_at])
  client_id             String
  user_id               BigInt
  redirect_uri          String
  scope                 String
  nonce                 String @default("")
  code_challenge        String @default("")
  code_challenge_method String @default("")
  expires_at            BigInt
  consumed_at           BigInt?
  session_id            String @default("")

  @@index([expires_at, consumed_at])
}

model passport_oidc_access_tokens {
  id                      BigInt @id @default(autoincrement())
  created_at              BigInt
  updated_at              BigInt
  deleted_at BigInt @default(0)
  created_duid            BigInt?
  updated_duid            BigInt?
  token_hash              String
  @@unique([token_hash, deleted_at])
  client_id               String
  user_id                 BigInt
  scope                   String
  expires_at              BigInt
  revoked_at              BigInt?
  session_id              String @default("")
  authorization_code_hash String?
  @@unique([authorization_code_hash, deleted_at])

  @@index([expires_at, revoked_at])
}

model passport_oidc_signing_keys {
  id           BigInt @id @default(autoincrement())
  created_at   BigInt
  updated_at   BigInt
  deleted_at BigInt @default(0)
  created_duid BigInt?
  updated_duid BigInt?
  kid          String
  @@unique([kid, deleted_at])
  private_jwk  String
  public_jwk   String
  status       PassportSigningKeyStatus @default(active)
}
